<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tsinghua</groupId>
        <artifactId>datamodelgov-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>datamodelgov-server</artifactId>
    <packaging>jar</packaging>

    <name>DataModelGov Server</name>
    <description>DataModelGov 服务端模块 - 包含REST API和Thrift RPC服务</description>

    <dependencies>
        <!-- 认证模块 -->
        <dependency>
            <groupId>com.tsinghua</groupId>
            <artifactId>datamodelgov-auth</artifactId>
        </dependency>

        <!-- 核心业务模块 -->
        <dependency>
            <groupId>com.tsinghua</groupId>
            <artifactId>datamodelgov-core</artifactId>
        </dependency>

        <!-- Spring Boot Starter Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Starter Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- 开发环境：可选包含SDK依赖 -->
        <profile>
            <id>dev-with-sdk</id>
            <dependencies>
                <dependency>
                    <groupId>com.tsinghua</groupId>
                    <artifactId>datamodelgov-sdk-java</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.tsinghua.DataModelGovApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- 资源打包配置 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <resources>
                        <resource>
                            <directory>src/main/resources</directory>
                            <includes>
                                <include>**/*</include>
                            </includes>
                        </resource>
                    </resources>
                </configuration>
            </plugin>

            <!-- 复制JDK（跨平台支持） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-jdk</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- 创建JDK目录 -->
                                <mkdir dir="${project.build.directory}/jdk"/>
                                
                                <!-- 检测操作系统并设置JDK路径 -->
                                <condition property="jdk.path" value="${env.JAVA_HOME}">
                                    <isset property="env.JAVA_HOME"/>
                                </condition>
                                <condition property="jdk.path" value="/usr/lib/jvm/java-8-openjdk-amd64">
                                    <available file="/usr/lib/jvm/java-8-openjdk-amd64/bin/java"/>
                                </condition>
                                <condition property="jdk.path" value="/usr/lib/jvm/java-8-openjdk">
                                    <available file="/usr/lib/jvm/java-8-openjdk/bin/java"/>
                                </condition>
                                <condition property="jdk.path" value="/Library/Java/JavaVirtualMachines/jdk1.8.0_181.jdk/Contents/Home">
                                    <available file="/Library/Java/JavaVirtualMachines/jdk1.8.0_181.jdk/Contents/Home/bin/java"/>
                                </condition>
                                <condition property="jdk.path" value="C:\Program Files\Java\jdk1.8.0_181">
                                    <available file="C:\Program Files\Java\jdk1.8.0_181\bin\java.exe"/>
                                </condition>
                                
                                <echo message="Copying JDK from: ${jdk.path}"/>
                                
                                <!-- 复制JDK核心文件 -->
                                <copy todir="${project.build.directory}/jdk" verbose="true" failonerror="true">
                                    <fileset dir="${jdk.path}">
                                        <include name="bin/**/*"/>
                                        <include name="lib/**/*"/>
                                        <include name="release"/>
                                        <include name="COPYRIGHT"/>
                                        <include name="LICENSE"/>
                                        <include name="README.html"/>
                                        <include name="THIRDPARTYLICENSEREADME*.txt"/>
                                        <exclude name="**/src/**"/>
                                        <exclude name="**/demo/**"/>
                                        <exclude name="**/sample/**"/>
                                        <exclude name="**/man/**"/>
                                        <exclude name="**/db/**"/>
                                        <exclude name="**/include/**"/>
                                        <exclude name="**/jmods/**"/>
                                        <exclude name="**/bin/*.exe" if="not ${os.family}='windows'"/>
                                        <exclude name="**/bin/*.bat" if="not ${os.family}='windows'"/>
                                        <exclude name="**/bin/*.sh" if="${os.family}='windows'"/>
                                    </fileset>
                                </copy>
                                
                                <echo message="JDK successfully copied to: ${project.build.directory}/jdk"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 复制依赖 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <excludeScope>provided</excludeScope>
                            <excludeTypes>sources,javadoc</excludeTypes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 创建完整发布包 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/distribution.xml</descriptor>
                    </descriptors>
                    <tarLongFileMode>posix</tarLongFileMode>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
