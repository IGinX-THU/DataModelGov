<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tsinghua</groupId>
        <artifactId>datamodelgov-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>datamodelgov-server</artifactId>
    <packaging>jar</packaging>

    <name>DataModelGov Server</name>
    <description>DataModelGov 服务端模块 - 包含REST API和Thrift RPC服务</description>

    <dependencies>
        <!-- 认证模块 -->
        <dependency>
            <groupId>com.tsinghua</groupId>
            <artifactId>datamodelgov-auth</artifactId>
        </dependency>

        <!-- 核心业务模块 -->
        <dependency>
            <groupId>com.tsinghua</groupId>
            <artifactId>datamodelgov-core</artifactId>
        </dependency>

        <!-- Spring Boot Starter Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Starter Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- 开发环境：可选包含SDK依赖 -->
        <profile>
            <id>dev-with-sdk</id>
            <dependencies>
                <dependency>
                    <groupId>com.tsinghua</groupId>
                    <artifactId>datamodelgov-sdk-java</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!-- Spring Boot Maven Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.tsinghua.DataModelGovApplication</mainClass>
                    <!-- 打包 MATLAB engine.jar（system scope），否则运行时找不到 com.mathworks.engine -->
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Maven Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- 资源打包配置 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <resources>
                        <resource>
                            <directory>src/main/resources</directory>
                            <includes>
                                <include>**/*</include>
                            </includes>
                        </resource>
                    </resources>
                </configuration>
            </plugin>

            <!-- 复制JDK（双平台支持） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-jdk-windows</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- 创建Windows JDK目录 -->
                                <mkdir dir="${project.build.directory}/jdk-windows"/>

                                <echo message="Copying Windows JDK..."/>

                                <!-- 复制Windows JDK -->
                                <copy todir="${project.build.directory}/jdk-windows" verbose="true" failonerror="true">
                                    <fileset dir="${java.home}">
                                        <include name="bin/**/*"/>
                                        <include name="lib/**/*"/>
                                        <include name="release"/>
                                        <include name="COPYRIGHT"/>
                                        <include name="LICENSE"/>
                                        <include name="README.html"/>
                                        <include name="THIRDPARTYLICENSEREADME*.txt"/>
                                        <exclude name="**/src/**"/>
                                        <exclude name="**/demo/**"/>
                                        <exclude name="**/sample/**"/>
                                        <exclude name="**/man/**"/>
                                        <exclude name="**/db/**"/>
                                        <exclude name="**/include/**"/>
                                        <exclude name="**/jmods/**"/>
                                    </fileset>
                                </copy>

                                <echo message="Windows JDK successfully copied"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-jdk-linux</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- 创建Linux JDK目录 -->
                                <mkdir dir="${project.build.directory}/jdk-linux"/>

                                <echo message="Creating portable Linux JDK..."/>

                                <!-- 创建Linux JDK目录结构 -->
                                <mkdir dir="${project.build.directory}/jdk-linux/bin"/>
                                <mkdir dir="${project.build.directory}/jdk-linux/lib"/>

                                <!-- 复制通用JDK文件（从Windows JDK） -->
                                <copy todir="${project.build.directory}/jdk-linux" verbose="true" failonerror="true">
                                    <fileset dir="${java.home}">
                                        <include name="lib/**/*"/>
                                        <include name="release"/>
                                        <include name="COPYRIGHT"/>
                                        <include name="LICENSE"/>
                                        <include name="README.html"/>
                                        <include name="THIRDPARTYLICENSEREADME*.txt"/>
                                        <exclude name="**/src/**"/>
                                        <exclude name="**/demo/**"/>
                                        <exclude name="**/sample/**"/>
                                        <exclude name="**/man/**"/>
                                        <exclude name="**/db/**"/>
                                        <exclude name="**/include/**"/>
                                        <exclude name="**/jmods/**"/>
                                    </fileset>
                                </copy>

                                <!-- 复制Linux可执行文件 -->
                                <echo message="Creating Linux executables..."/>
                                <echo file="${project.build.directory}/jdk-linux/bin/java" message="#!/bin/bash&#10;echo 'Portable Java 8 for Linux'&#10;echo 'Please install OpenJDK 8 on your system:'&#10;echo '  sudo apt-get install openjdk-8-jdk'&#10;echo '  sudo yum install java-1.8.0-openjdk'&#10;echo '  sudo dnf install java-1.8.0-openjdk'&#10;echo 'Then use system Java with: java -version'&#10;exit 1"/>

                                <chmod file="${project.build.directory}/jdk-linux/bin/java" perm="755"/>

                                <echo message="Linux JDK stub created"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 复制依赖 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <excludeScope>provided</excludeScope>
                            <excludeTypes>sources,javadoc</excludeTypes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 创建完整发布包 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/distribution.xml</descriptor>
                    </descriptors>
                    <tarLongFileMode>posix</tarLongFileMode>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
